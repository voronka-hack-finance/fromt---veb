NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000
APP_DOMAIN=zanachka.avenir-team.ru
LETSENCRYPT_EMAIL=YOUR_EMAIL@example.com

# Backend base URL. By default the frontend also falls back to
# https://zanachka.avenir-team.ru, but setting it explicitly is recommended.
NEXT_PUBLIC_API_URL=https://zanachka.avenir-team.ru

# Optional static token for quick integration checks without a login screen.
# In a normal flow, use POST /api/v1/auth/login and keep tokens in localStorage.
# NEXT_PUBLIC_API_TOKEN=

# Firebase Cloud Messaging (Web Push)
# VAPID key: Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
